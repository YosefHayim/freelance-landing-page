{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "Ready on",
      "url": ["http://127.0.0.1:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "blockedUrlPatterns": [
          "*://connect.facebook.net/*",
          "*://www.googletagmanager.com/*",
          "*://analytics.tiktok.com/*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.98, "aggregationMethod": "median-run" }
        ],
        "first-contentful-paint": [
          "error",
          { "maxNumericValue": 1500, "aggregationMethod": "median-run" }
        ],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 100, "aggregationMethod": "median-run" }
        ]
      }
    }
  }
}
